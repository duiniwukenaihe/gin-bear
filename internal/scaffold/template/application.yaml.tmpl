server:
  port: 8080
  name: {{yamlScalar .Name}}
  shutdown_timeout: "5s"

config:
  strict: true
  framework.strict: true
  framework.response_mode: "envelope"

grpc:
  enabled: false

# Generated CRUD resources inject *bear.GormAdapter, which the framework only
# registers while the database is enabled, so `bear gen api` warns and writes no
# migration until you enable one. A local SQLite database is enough to run a
# generated resource:
#
#   database:
#     enabled: true
#     type: "sqlite"
#     dsn: {{yamlScalar (printf "%s.db" .Name)}}
#
# Release mode (GIN_MODE=release) rejects SQLite as a production database, so a
# real deployment needs MySQL or PostgreSQL instead; application-prod.yaml.example
# shows that shape. When enabled, database.type selects exactly one driver.
# Other databases are not opened or probed.
database:
  enabled: false

redis:
  required: false
  # Keep false for local plaintext Redis. Enable TLS for remote Redis.
  tls:
    enabled: false
    server_name: ""
    ca_file: ""
    cert_file: ""
    key_file: ""

tracing:
  enabled: false
  service_name: {{yamlScalar .Name}}
  exporter: "stdout"
  sample_rate: 1.0

auth:
  enabled: false
  jwt_secret: "" # Required via BEAR_AUTH_JWT_SECRET when auth.enabled=true in production.
  token_expire_hours: 24
  public_paths:
    - "/health"
    - "/live"
    - "/ready"

metrics:
  enabled: true
  path: "/metrics"

# Dynamic Go plugins are optional and never loaded when disabled.
plugins:
  enabled: false
