server:
  port: 8080
  name: {{yamlScalar .Name}}
  shutdown_timeout: "5s"

database:
  enabled: false

tracing:
  enabled: false
  service_name: {{yamlScalar .Name}}
  exporter: "stdout"
  sample_rate: 1.0

auth:
  jwt_secret: "" # Required via JWT_SECRET in production.
  token_expire_hours: 24
  public_paths:
    - "/health"
    - "/live"
    - "/ready"
    - "/version"
    - "/metrics"

metrics:
  enabled: true
  path: "/metrics"
