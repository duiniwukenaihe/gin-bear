package main

import (
	"context"
	"log/slog"
	"os"
	"os/signal"

	"{{.Module}}/internal/app"
)

func main() {
	if err := run(); err != nil {
		slog.Error("server stopped", "error", err)
		os.Exit(1)
	}
}

func run() error {
	ctx, stop := signal.NotifyContext(context.Background(), shutdownSignals()...)
	defer stop()
	return app.Run(ctx)
}
