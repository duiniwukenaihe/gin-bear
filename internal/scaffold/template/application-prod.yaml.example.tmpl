server:
  port: 8080
  name: {{yamlScalar .Name}}
  mode: "release"
  trusted_proxies:
    - "127.0.0.1"
  read_header_timeout: "5s"
  read_timeout: "15s"
  write_timeout: "30s"
  idle_timeout: "60s"
  shutdown_timeout: "10s"
  max_header_bytes: 1048576
  max_request_body_bytes: 1048576

config:
  strict: true
  framework.strict: true
  framework.response_mode: "envelope"

cors:
  enabled: false
  allow_origins:
    - "https://example.com"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "PATCH"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Content-Type"
    - "Authorization"
    - "X-Request-ID"
  allow_credentials: false
  max_age: "12h"

database:
  enabled: true
  type: "postgres"
  host: "127.0.0.1" # Override with POSTGRES_HOST.
  port: "5432"
  user: "gin_bear"
  password: "" # Set with POSTGRES_PASSWORD.
  dbname: "gin_bear"
  sslmode: "verify-full"

redis:
  addr: "127.0.0.1:6379" # Override with REDIS_ADDR.
  password: ""
  db: 0
  required: false

tracing:
  enabled: false
  service_name: {{yamlScalar .Name}}
  exporter: "otlp"
  otlp_endpoint: "http://127.0.0.1:4318/v1/traces" # Override with TRACING_OTLP_ENDPOINT.
  sample_rate: 1.0

auth:
  jwt_secret: "" # Required via BEAR_AUTH_JWT_SECRET.
  token_expire_hours: 24
  public_paths:
    - "/health"
    - "/live"
    - "/ready"
    - "/version"

metrics:
  enabled: false
  path: "/metrics"
