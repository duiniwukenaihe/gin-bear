server:
  port: 8080
  name: {{yamlScalar .Name}}
  mode: "release"
  trusted_proxies:
    - "127.0.0.1"
  read_header_timeout: "5s"
  read_timeout: "15s"
  write_timeout: "30s"
  idle_timeout: "60s"
  shutdown_timeout: "10s"
  max_header_bytes: 1048576
  max_request_body_bytes: 1048576

config:
  strict: true
  framework.strict: true
  framework.allow_compatibility_in_production: false
  framework.response_mode: "envelope"

# gRPC remains disabled. Uncomment and set enabled: true only after registering
# a business service with AddGRPCServiceE.
# Plaintext is only for a same-host Nginx or Envoy that terminates TLS before
# proxying to this loopback listener.
# grpc:
#   enabled: false
#   host: "127.0.0.1"
#   port: 9090
#   transport_security: "plaintext"
#   tls_cert_file: ""
#   tls_key_file: ""
#   client_ca_file: ""
#   max_recv_message_bytes: 4194304
#   max_send_message_bytes: 4194304
#   max_concurrent_streams: 128
#   keepalive_min_time: "5m"
#   keepalive_time: "2h"
#   keepalive_timeout: "20s"
#   max_connection_idle: "15m"
#   max_connection_age: "2h"
#   max_connection_age_grace: "5m"
#   health_enabled: true
#   reflection_enabled: false
# For process-terminated TLS, set transport_security: "tls" and provide real
# tls_cert_file and tls_key_file paths through deployment-owned configuration.
# For mutual TLS, set transport_security: "mtls" and also provide client_ca_file.

cors:
  enabled: false
  allow_origins:
    - "https://example.com"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "PATCH"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Content-Type"
    - "Authorization"
    - "X-Request-ID"
  allow_credentials: false
  max_age: "12h"

database:
  enabled: true
  type: "postgres"
  host: "127.0.0.1" # Override with POSTGRES_HOST.
  port: "5432"
  user: "gin_bear"
  password: "" # Set with POSTGRES_PASSWORD.
  dbname: "gin_bear"
  sslmode: "verify-full"

redis:
  addr: "127.0.0.1:6379" # Override with REDIS_ADDR.
  password: ""
  db: 0
  required: false

tracing:
  enabled: false
  service_name: {{yamlScalar .Name}}
  exporter: "otlp"
  otlp_endpoint: "http://127.0.0.1:4318/v1/traces" # Override with TRACING_OTLP_ENDPOINT.
  sample_rate: 1.0

auth:
  enabled: false
  jwt_secret: "" # Required via BEAR_AUTH_JWT_SECRET when auth.enabled=true.
  token_expire_hours: 24
  public_paths:
    - "/health"
    - "/live"
    - "/ready"

metrics:
  enabled: false
  path: "/metrics"
