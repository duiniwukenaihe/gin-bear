server:
  port: 8080
  name: {{yamlScalar .Name}}
  mode: "release"
  shutdown_timeout: "10s"
  trusted_proxies:
    - "127.0.0.1"

database:
  enabled: true
  type: "postgres"
  host: "postgres"
  port: "5432"
  user: "gin_bear"
  password: "" # Set with POSTGRES_PASSWORD.
  dbname: "gin_bear"
  sslmode: "verify-full"

tracing:
  enabled: false
  service_name: {{yamlScalar .Name}}
  exporter: "otlp"
  otlp_endpoint: "http://otel-collector:4318/v1/traces"
  sample_rate: 1.0

auth:
  jwt_secret: "" # Required via BEAR_AUTH_JWT_SECRET.
  token_expire_hours: 24
  public_paths:
    - "/health"
    - "/live"
    - "/ready"
    - "/version"

metrics:
  enabled: false
  path: "/metrics"
