server:
  port: 8080
  name: "gin-bear"
  mode: "release"
  trusted_proxies:
    - "127.0.0.1"
  read_header_timeout: "5s"
  read_timeout: "15s"
  write_timeout: "30s"
  idle_timeout: "60s"
  shutdown_timeout: "10s"
  max_header_bytes: 1048576
  max_request_body_bytes: 1048576

config:
  strict: true
  framework.strict: true
  framework.response_mode: "envelope"

health:
  readiness_timeout: "3s"

log:
  level: "info"

cors:
  enabled: false
  allow_origins:
    - "https://example.com"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "PATCH"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Content-Type"
    - "Authorization"
    - "X-Request-ID"
  allow_credentials: false
  max_age: "12h"

database:
  enabled: true
  type: "postgres"
  host: "127.0.0.1" # Override with POSTGRES_HOST.
  port: "5432"
  user: "gin_bear"
  password: "" # Set with POSTGRES_PASSWORD.
  dbname: "gin_bear"
  sslmode: "verify-full"
  max_idle_conns: 10
  max_open_conns: 50
  conn_max_lifetime_minutes: 60
  slow_query_threshold: "500ms"

redis:
  addr: "127.0.0.1:6379" # Override with REDIS_ADDR.
  password: ""
  db: 0
  pool_size: 20
  min_idle_conns: 2
  dial_timeout_seconds: 5
  read_timeout_seconds: 3
  write_timeout_seconds: 3
  required: false
  # Keep false only for loopback Redis or a trusted local proxy/sidecar.
  # Remote Redis deployments should enable TLS and use deployment-owned files.
  tls:
    enabled: false
    server_name: ""
    ca_file: ""
    cert_file: ""
    key_file: ""

tracing:
  enabled: false
  service_name: "gin-bear"
  exporter: "otlp"
  otlp_endpoint: "http://127.0.0.1:4318/v1/traces" # Override with TRACING_OTLP_ENDPOINT.
  sample_rate: 1.0

websocket:
  handshake_timeout_ms: 10000
  read_buffer_size: 1024
  write_buffer_size: 1024
  check_origin: true
  allowed_origins:
    - "https://example.com"

auth:
  enabled: true
  storage_type: "redis"
  jwt_secret: "" # Required via BEAR_AUTH_JWT_SECRET.
  jwt_issuer: "https://auth.example.com"
  jwt_audience: "gin-bear-api"
  jwt_clock_skew: "30s"
  token_expire_hours: 24
  public_paths:
    - "/health"
    - "/live"
    - "/ready"
    - "/swagger/*"

middleware:
  performance_log_level: "info"
  slow_request_threshold: "1s"

metrics:
  enabled: false
  path: "/metrics"

plugins:
  enabled: false
  allowed_dirs:
    - "/app/plugins"
